# Copy to .traceforge-deploy/deployment.env. Secrets and data must stay outside Git.
TRACEFORGE_PROJECT=traceforge
# Explicitly select the Docker host. Linux servers normally use default.
TRACEFORGE_DOCKER_CONTEXT=default
TRACEFORGE_PROFILE=server
TRACEFORGE_DATA_DIR=/srv/traceforge
TRACEFORGE_IMAGE_NAMESPACE=aididalam
TRACEFORGE_VERSION=deployment-20261008
TRACEFORGE_UID=1000
TRACEFORGE_GID=1000
# Runtime public origin used by the proxy, login checks, copied links and QR.
# No domain yet: http://127.0.0.1:3101 with HTTP_PORT=3101, HTTP_BIND=127.0.0.1.
# Changing this setting requires `make up`, never an application image rebuild.
TRACEFORGE_SITE_ORIGIN=https://trace.example.com
TRACEFORGE_HTTP_BIND=0.0.0.0
TRACEFORGE_HTTP_PORT=80
TRACEFORGE_HTTPS_PORT=443
TRACEFORGE_CHAIN_MODE=external
TRACEFORGE_CHAIN_DATA_DIR=/srv/traceforge/chain
# Set this to an existing Docker network when Besu is colocated with the app.
TRACEFORGE_CHAIN_NETWORK=
TRACEFORGE_BESU_IMAGE=hyperledger/besu:26.9.0
TRACEFORGE_BESU_JAVA_OPTS=-Xmx512m
TRACEFORGE_BESU_MEMORY=768m
# Preserve this choice for an existing chain; changing it requires data migration.
TRACEFORGE_BESU_STORAGE_FORMAT=BONSAI
TRACEFORGE_DATABASE_MODE=managed
# External RPC must be reachable FROM the containers. Keep RPC on a private network.
TRACEFORGE_RPC_URL=http://host.docker.internal:8545
TRACEFORGE_RPC_FALLBACK_URLS=
TRACEFORGE_CHAIN_ID=9009
TRACEFORGE_CONTRACT_ADDRESS=0xf286a8f7bbbe4e5f2337e1701524368794de5672
TRACEFORGE_DEPLOYMENT_BLOCK=27861
TRACEFORGE_RUNTIME_BYTECODE_HASH=0x8b81a848236820215ceca237aa5cd419b858733688db3814e077199087c9b0e8
TRACEFORGE_BROADCAST_ENABLED=true
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=traceforge
MYSQL_USER=traceforge
# Relative secret paths resolve against TRACEFORGE_DATA_DIR.
MYSQL_PASSWORD_FILE=secrets/mysql-password
MYSQL_ROOT_PASSWORD_FILE=secrets/mysql-root-password
TRACEFORGE_SESSION_KEY_FILE=secrets/session-key
TRACEFORGE_BACKUP_KEY_FILE=secrets/backup-key
TRACEFORGE_PROXY_KEY_FILE=secrets/proxy-key
INDEXER_CONFIRMATIONS=1
INDEXER_CHUNK_SIZE=500
TRACEFORGE_SYNC_INTERVAL_SECONDS=5
TRACEFORGE_BACKUP_RETENTION_DAYS=14
# Set an existing private backup directory on a separate mounted host/storage.
TRACEFORGE_BACKUP_DESTINATION=

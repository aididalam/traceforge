# syntax=docker/dockerfile:1
FROM docker:29.6.1-cli AS docker-cli
FROM node:22.23.3-bookworm-slim
COPY LICENSE /usr/share/licenses/traceforge/LICENSE
LABEL org.opencontainers.image.licenses="MIT"
COPY --from=docker-cli /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/lib/docker/cli-plugins
USER node
ENTRYPOINT ["node"]

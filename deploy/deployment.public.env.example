# Copy to .traceforge-deploy/public.env (chmod 600). Start with a testnet.
TRACEFORGE_NETWORK_KIND=public
TRACEFORGE_PROJECT=traceforge-public
TRACEFORGE_DOCKER_CONTEXT=default
TRACEFORGE_PROFILE=server
TRACEFORGE_DATA_DIR=/srv/traceforge-public
TRACEFORGE_IMAGE_NAMESPACE=aididalam
TRACEFORGE_VERSION=v0.3.1
TRACEFORGE_IMAGE_MODE=pull
TRACEFORGE_SITE_ORIGIN=http://127.0.0.1:3102
TRACEFORGE_HTTP_BIND=127.0.0.1
TRACEFORGE_HTTP_PORT=3102
TRACEFORGE_HTTPS_PORT=3444
TRACEFORGE_CHAIN_MODE=external
# Provider must support eth_getLogs, finalized blocks and raw transaction submission.
# Authenticated providers can use a path, e.g. https://provider.example/v2/API_KEY.
TRACEFORGE_RPC_URL=https://polygon-amoy.drpc.org
TRACEFORGE_RPC_FALLBACK_URLS=
TRACEFORGE_CHAIN_ID=80002
TRACEFORGE_NATIVE_SYMBOL=POL
TRACEFORGE_FEE_MODE=auto
# Caps apply to the maximum gas price and total gas fee per transaction.
TRACEFORGE_MAX_FEE_GWEI=1000
TRACEFORGE_MAX_TRANSACTION_FEE=0.1
TRACEFORGE_FEE_RETRY_SECONDS=120
TRACEFORGE_CONTRACT_ADDRESS=
TRACEFORGE_DEPLOYMENT_BLOCK=0
TRACEFORGE_RUNTIME_BYTECODE_HASH=
TRACEFORGE_BROADCAST_ENABLED=true
TRACEFORGE_NETWORK_BOOTSTRAP_ENABLED=false
TRACEFORGE_NETWORK_BOOTSTRAP_TOKEN_FILE=secrets/network-bootstrap-token
TRACEFORGE_DATABASE_MODE=managed
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=traceforge_public
MYSQL_USER=traceforge
MYSQL_PASSWORD_FILE=secrets/mysql-password
MYSQL_ROOT_PASSWORD_FILE=secrets/mysql-root-password
TRACEFORGE_SESSION_KEY_FILE=secrets/session-key
TRACEFORGE_BACKUP_KEY_FILE=secrets/backup-key
TRACEFORGE_PROXY_KEY_FILE=secrets/proxy-key
# Public mode uses finalized blocks; confirmations is used only in private mode.
INDEXER_CONFIRMATIONS=1
INDEXER_CHUNK_SIZE=100
TRACEFORGE_SYNC_INTERVAL_SECONDS=15
TRACEFORGE_BACKUP_RETENTION_DAYS=14
TRACEFORGE_BACKUP_DESTINATION=

[Unit]
Description=TraceForge Health and Lag Monitor
After=network-online.target traceforge-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=traceforge
Group=traceforge
WorkingDirectory=/opt/traceforge

Environment=TRACEFORGE_ROOT=/opt/traceforge
Environment=TRACEFORGE_API_URL=http://127.0.0.1:3000
EnvironmentFile=/etc/traceforge/indexer.env
EnvironmentFile=-/etc/traceforge/monitor.env

ExecStart=/opt/traceforge/ops/monitoring/check.sh

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
